# Which folder under clients/ to build for
VITE_CLIENT=example
# Supabase project URL and publishable (anon) key. Safe in the browser; RLS is the security layer.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Email of the shared editor user created in Supabase Auth (use .example.com, not .local)
VITE_EDITOR_EMAIL=editor@your-client-slug.example.com
